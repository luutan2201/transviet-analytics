# App
NEXT_PUBLIC_APP_NAME="TransViet Analytics"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_DEFAULT_YEAR=2026

# Data source — Google Apps Script Web App URL (see 21_GOOGLE_APPS_SCRIPT_SPEC.md)
# Never commit the real value. Never expose it in source code comments.
NEXT_PUBLIC_APPS_SCRIPT_URL=

# Authentication (mock, single-admin — see 12_AUTHENTICATION.md)
AUTH_USERNAME=
AUTH_PASSWORD=
# Minimum 16 characters. Generate one with: openssl rand -base64 32
AUTH_SESSION_SECRET=

# AI Provider (optional — leave blank to use the built-in rule-based report generator).
# AI_PROVIDER must be one of: claude | openai | gemini
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
